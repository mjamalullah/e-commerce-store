# Database (SQLite default for zero-config local run, switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://postgres:password@db.example.com:5432/apex_commerce?schema=public"

# App & Auth
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="apex-commerce-super-secret-jwt-key-2026-production-ready"

# Media Storage Provider: "local" (default), "cloudinary", or "supabase"
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Default Currency & Store
DEFAULT_CURRENCY="PKR"
DEFAULT_CURRENCY_SYMBOL="Rs."
